# Cloud Functions v2 loads .env files in this directory automatically.
# Copy this to .env (git-ignored) to override defaults; redeploy after changes.

# Rejects calls to the OTP/Shamir-bypass functions that don't carry a valid
# Firebase App Check token — see README.md's "DDoS 방지" section. Leave
# false until the client actually has a working reCAPTCHA Enterprise site key
# (NEXT_PUBLIC_RECAPTCHA_SITE_KEY) AND that key is registered under App
# Check's "reCAPTCHA Enterprise" provider with its secret key, or every call
# will start failing.
APP_CHECK_ENFORCE=true
