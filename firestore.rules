rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Base64 field guard. Every key/ciphertext field in this schema is
    // base64 produced by lib/crypto/encoding.ts, so bounding each one
    // keeps a scripted client from parking megabytes of junk in fields
    // that rules would otherwise never look at. Sizes are the real
    // encoded lengths plus generous headroom (e.g. an ML-KEM-768
    // ciphertext is 1088 bytes -> ~1452 base64 chars).
    //
    // security-patch-v2 / H2: despite the name, this used to check ONLY
    // length, not that the value is actually base64 — a string like "!!!"
    // passed. lib/crypto/encoding.ts's base64ToBytes throws
    // "Invalid base64 character" on the first byte outside its lookup
    // table, and lib/firebase/entries.ts's listEntries() calls it inside a
    // bare Array.map with no per-entry try/catch, so ONE such document
    // (entries are append-only and can never be deleted once written)
    // rejects the whole listEntries() promise — app/entries/page.tsx's
    // .catch just marks metadataLoaded and leaves `metadata` at its
    // initial empty array, rendering "아직 작성한 일기가 없습니다" as if the
    // diary were empty. Every OTHER entry, and the account itself, stays
    // completely fine; nothing is actually lost — but the owner has no way
    // to know that from what the UI shows them. Requiring the base64
    // alphabet here means that document can never be written in the first
    // place. This is the standard alphabet (A-Za-z0-9+/, `=` padding) that
    // bytesToBase64 produces; publicKeys.x25519.x is the one field encoded
    // with bytesToBase64Url instead (no padding, `-`/`_` in place of
    // `+`/`/`) — see isB64Url below.
    function isB64(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen
          && value.matches('^[A-Za-z0-9+/]*={0,2}$');
    }

    // base64url (RFC 4648 §5), as produced by
    // lib/crypto/encoding.ts's bytesToBase64Url — currently only
    // publicKeys.x25519.x is encoded this way (bytesToBase64Url strips
    // padding and swaps in `-`/`_`); everything else in this schema uses
    // isB64 above.
    function isB64Url(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen
          && value.matches('^[A-Za-z0-9_-]+$');
    }

    // The passphrase-wrapped master seed (ARCHITECTURE.md §3.1 step 5).
    // `kdfParams.iterations` carries a FLOOR, not just a type check: the
    // client feeds this stored value straight back into PBKDF2 on unwrap
    // (lib/crypto/passphrase.ts's unwrapSeed reads wrapped.kdfParams.
    // iterations), so a document that says `iterations: 1` would make any
    // future offline attack on the wrapped seed trivial. Pinning the floor
    // to the constant lib/crypto ships with (PBKDF2_ITERATIONS) means a
    // downgraded or tampered client can never weaken the KDF below what
    // this codebase considers acceptable — only raise it.
    function isValidWrappedSeed(seed) {
      return seed.keys().hasOnly(['ciphertext', 'iv', 'salt', 'kdf', 'kdfParams'])
          && isB64(seed.ciphertext, 200)
          && isB64(seed.iv, 32)
          && isB64(seed.salt, 32)
          && seed.kdf == 'pbkdf2'
          && seed.kdfParams.keys().hasOnly(['iterations', 'hash'])
          && seed.kdfParams.iterations is int
          && seed.kdfParams.iterations >= 600000
          && seed.kdfParams.hash == 'SHA-256';
    }

    // Shamir's Secret Sharing: the sole alternative to the passphrase
    // (opt-in) — replaces the removed BIP39 mnemonic and the earlier
    // recovery-key option (see lib/crypto/recovery.ts, ARCHITECTURE.md
    // §3.7). Shares split a random wrap key, not the seed itself, so that
    // key's `wrappedSeed` ciphertext (AES-GCM, same shape as the top-level
    // wrappedSeed) is what's stored here — the shares themselves are never
    // sent to Firestore at all. Reissuing overwrites this ciphertext, which
    // is what actually invalidates any previously-issued shares.
    //
    // `otpBypassVerifier` (ARCHITECTURE.md §3.8) is a one-way HKDF
    // derivative of the same wrap key, optional only because it predates
    // accounts that set up Shamir before this field existed — only
    // functions/src/index.ts's verifyShamirOtpBypass ever reads it.
    //
    // SECURITY: this field is the server-side half of the OTP-bypass
    // comparison, so being able to write it is equivalent to being able to
    // satisfy the OTP gate. `n`/`k` are bounded here, but what actually
    // stops a session-only attacker from planting a verifier it knows the
    // preimage of is the otpSatisfied() gate on `allow update` below — see
    // isOtpUngatedChange().
    function isValidDecryptionMethods(methods) {
      return methods.keys().hasOnly(['shamir'])
          && (!('shamir' in methods)
              || (methods.shamir.keys().hasOnly(['n', 'k', 'wrappedSeed', 'otpBypassVerifier'])
                  && methods.shamir.n is int && methods.shamir.n >= 2 && methods.shamir.n <= 255
                  && methods.shamir.k is int && methods.shamir.k >= 2
                  && methods.shamir.k <= methods.shamir.n
                  && methods.shamir.wrappedSeed.keys().hasOnly(['ciphertext', 'iv'])
                  && isB64(methods.shamir.wrappedSeed.ciphertext, 200)
                  && isB64(methods.shamir.wrappedSeed.iv, 32)
                  && (!('otpBypassVerifier' in methods.shamir)
                      || isB64(methods.shamir.otpBypassVerifier, 64))));
    }

    // Pure display preferences (ARCHITECTURE.md §3.9, lib/preferences.ts) —
    // never read by lib/crypto or functions/, so this validates shape only,
    // not any access decision. Stays in isOtpUngatedChange()'s exempt list
    // below: unlike `security` (right after this), nothing here changes how
    // exposed an unlocked session or a stored draft is.
    function isValidPreferences(prefs) {
      return prefs.keys().hasOnly(['privateWritingMode', 'privateWritingPeekAllowed'])
          && (!('privateWritingMode' in prefs) || prefs.privateWritingMode is bool)
          && (!('privateWritingPeekAllowed' in prefs) || prefs.privateWritingPeekAllowed is bool);
    }

    // security-patch-v2 merge / preferences split: `autoLockMinutes` and
    // `draftAutosave` (lib/preferences.ts) started out bundled into the
    // cosmetic `preferences` map above, gated only by otpSatisfied() — but
    // that gate is vacuously true for the many accounts that never enabled
    // OTP (see credentialMutationAllowed() below), which would have left
    // these two exposure controls exactly as unprotected against a
    // session-only attacker as C1 found wrappedSeed/publicKeys/
    // decryptionMethods to be. Splitting them into their own top-level
    // `security` field — gated by credentialMutationAllowed(), same as
    // those credential-bearing fields — closes that gap instead of
    // reproducing it under a new name. `preferences` itself reverts to
    // being purely cosmetic and stays ungated.
    //
    // `autoLockMinutes` is pinned to the exact set the UI offers rather
    // than a range, for the same reason isValidWrappedSeed pins the PBKDF2
    // iteration floor: the client feeds this value straight back into a
    // security decision, and a number this codebase would never produce
    // (say 100000) would silently mean "never lock". 0 IS in the set —
    // that is the explicit "사용 안 함" choice.
    function isValidSecurityPreferences(sec) {
      return sec.keys().hasOnly(['autoLockMinutes', 'draftAutosave'])
          && (!('draftAutosave' in sec) || sec.draftAutosave is bool)
          && (!('autoLockMinutes' in sec)
              || (sec.autoLockMinutes is int && sec.autoLockMinutes in [0, 1, 5, 15, 30, 60]));
    }

    // security-patch-v2 / H1: the real ceiling on how many entries a real
    // diary needs — daily writes for centuries. entrySeq/lastEntrySeq had
    // no upper bound before this, so a single crafted entry with, say,
    // entrySeq: 1e9 was accepted, and lib/firebase/entrySequence.ts's
    // checkEntrySequence() (which every /entries page load runs) walks
    // 1..highestSeen collecting missingSeqs — linear in that value, with no
    // early exit (entries can never be deleted once written, so this isn't
    // a one-time cost). Measured: ~30ms/35MB at 1e6, ~360ms/255MB at 1e7 —
    // an entrySeq near 1e9 is tens of seconds and hundreds of MB on every
    // single page load, indefinitely, with no way to remove the offending
    // document. Bounding entrySeq here is what actually prevents the
    // document from ever being written.
    function maxEntrySeq() {
      return 1000000;
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(['publicKeys', 'wrappedSeed', 'decryptionMethods', 'preferences', 'security', 'lastEntrySeq', 'createdAt'])
          && data.publicKeys.keys().hasOnly(['x25519', 'mlkem768'])
          && isB64(data.publicKeys.mlkem768, 2048)
          && data.publicKeys.x25519 is map
          && data.publicKeys.x25519.keys().hasOnly(['kty', 'crv', 'x'])
          && isB64Url(data.publicKeys.x25519.x, 64)
          && isValidWrappedSeed(data.wrappedSeed)
          && (!('decryptionMethods' in data) || isValidDecryptionMethods(data.decryptionMethods))
          && (!('preferences' in data) || isValidPreferences(data.preferences))
          && (!('security' in data) || isValidSecurityPreferences(data.security))
          && (!('lastEntrySeq' in data)
              || (data.lastEntrySeq is int && data.lastEntrySeq >= 0 && data.lastEntrySeq <= maxEntrySeq()));
    }

    // OTP (TOTP authenticator app) as a server-enforced ACCESS GATE, not a
    // cryptographic factor — see functions/src/index.ts's module doc for
    // why that distinction matters. `otpEnabled` / `otpVerified` /
    // `otpVerifiedAt` are custom claims that only Cloud Functions
    // (functions/src/index.ts, via the Admin SDK) can set — never
    // client-writable, so a client can't forge its way past this by
    // setting its own claims. An account without OTP enabled is
    // unaffected (otpEnabled != true short-circuits to allowed).
    //
    // `otpVerified`/`otpVerifiedAt` can ALSO be set by
    // verifyShamirOtpBypass (ARCHITECTURE.md §3.8) instead of a real TOTP
    // code — deliberate: forcing OTP on top of the Shamir recovery path
    // would mean losing the OTP device could permanently block the one
    // credential meant to survive losing everything else. This rule can't
    // (and doesn't need to) tell which route set the claims; either way
    // they're only set after the Cloud Function verified real proof of
    // possession of a real credential.
    function otpSatisfied() {
      // request.auth.token.get(key, default) — a bare `.otpEnabled` throws
      // an evaluation error (not just falsy) for accounts that never set
      // the claim, since Firestore rules maps raise on missing keys.
      return request.auth.token.get('otpEnabled', false) != true
          || (request.auth.token.get('otpVerified', false) == true
              && request.auth.token.get('otpVerifiedAt', 0) > request.time.toMillis() - 43200000); // 12h session
    }

    // security-patch-v2 / C1: `auth_time` is a standard ID-token claim —
    // the Unix-seconds moment of the actual sign-in/reauthentication event.
    // Unlike everything else on the token it does NOT advance on silent ID
    // token refresh, so requiring it to be recent forces proof of the
    // LOGIN credential (mirrors functions/src/authFreshness.ts's
    // isAuthTimeFresh, which functions/src/index.ts's requireRecentAuth
    // uses for the same reason — see that module's doc comment for the
    // full threat this closes). Deliberately NOT folded into otpSatisfied():
    // that function also gates `entries/{entryId}` reads, and a normal,
    // long-lived-but-never-reauthenticated session reading its own diary
    // is completely expected — only WRITES that grant or replace a master
    // credential (or, since the preferences split below, a security
    // control) need this.
    function isRecentAuth() {
      return request.auth.token.auth_time is number
          && request.time.toMillis() - (request.auth.token.auth_time * 1000) <= 300000; // 5 min
    }

    // The two fields on users/{uid} that carry no security weight and so
    // stay writable without passing either gate below:
    //
    //  - `preferences` — purely cosmetic (privateWritingMode,
    //    privateWritingPeekAllowed; ARCHITECTURE.md §3.9). `autoLockMinutes`
    //    and `draftAutosave` used to live here too, on the same "no
    //    security weight" reasoning — but they decide how long an unlocked
    //    session stays readable and whether drafts touch disk in
    //    plaintext, so leaving them exempt would have let a session-only
    //    attacker switch a victim's auto-lock off (or drafts on) and wait.
    //    They now live in their own `security` field instead (see
    //    isValidSecurityPreferences above), gated by
    //    credentialMutationAllowed() below exactly like wrappedSeed/
    //    publicKeys/decryptionMethods — closing the same C1-shaped hole
    //    for these two fields that C1 closed for those.
    //  - `lastEntrySeq` — the entry-sequence hint the write path bumps on
    //    every save. Writing a diary entry must keep working without any
    //    unlock step (ARCHITECTURE.md §3.2 rule 5), and the OTP gate is
    //    deliberately a READ gate, so the write path must not depend on
    //    it. A session-only attacker can push this number forward, which
    //    costs nothing: the number is a hint, the authoritative binding is
    //    the AES-GCM AAD on each entry, and app/entries/page.tsx
    //    cross-checks it against the entries actually present.
    function isOtpUngatedChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['preferences', 'lastEntrySeq']);
    }

    // ARCHITECTURE.md §5 gives `allow update: if ... isKeyRotationRequest()`
    // without defining the function — filled in here. It covers all
    // self-service mutations of the account owner's OWN document:
    //   1. Passphrase change (Phase 4 rewrapSeed): only wrappedSeed changes.
    //   2. Full key reset ("초기화", ARCHITECTURE.md §3.6 rule 5): a brand
    //      new seed, so publicKeys + wrappedSeed (+ decryptionMethods reset
    //      to {}) change together.
    //   3. Enabling/disabling one decryption method: only `decryptionMethods`
    //      (a single sub-field of it, via dotted-path updates) changes.
    //   4. A display-preference change (§3.9): only `preferences` changes —
    //      reachable via isOtpUngatedChange() without either gate below.
    //   5. A security-preference change (§3.11, §3.12): only `security`
    //      changes — reachable only via credentialMutationAllowed() below,
    //      same as a credential-bearing field.
    //   6. An entry-sequence bump from the write path: only `lastEntrySeq`.
    // In every case createdAt is immutable and the document shape stays
    // valid. This only ever narrows what an authenticated uid can do to ITS
    // OWN doc — the outer `request.auth.uid == uid` check is what actually
    // prevents cross-user access, not this function.
    //
    // `lastEntrySeq` is additionally forced to move forward only: letting
    // it rewind would let a stale or hostile client hand out entry
    // sequence numbers that collide with entries already written.
    function isKeyRotationRequest() {
      return isValidUserDoc(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('lastEntrySeq' in request.resource.data)
              || !('lastEntrySeq' in resource.data)
              || request.resource.data.lastEntrySeq >= resource.data.lastEntrySeq);
    }

    // security-patch-v2 / C1: otpSatisfied() ALONE used to gate every
    // credential-bearing update, but it's vacuously true the instant
    // otpEnabled isn't set (`!= true` short-circuits) — which is every
    // account that hasn't opted into OTP, i.e. most accounts. That meant a
    // session-only attacker (stolen ID token / XSS — no passphrase, no
    // Shamir shares) could freely overwrite wrappedSeed/publicKeys/
    // decryptionMethods on any non-OTP account: a full key-reset destroys
    // every existing entry irreversibly (append-only, undeletable), a
    // wrappedSeed-only overwrite stops the real passphrase from ever
    // unwrapping the seed again (arguably worse — not even a fresh usable
    // seed is left behind), and a decryptionMethods.shamir overwrite
    // strands whatever real shares were issued. None of the flows that
    // legitimately perform these writes (passphrase change, Shamir setup/
    // reissue/disable, full reset) can have their real proof — a local
    // AES-GCM unwrap/combine — verified here; the server never sees a
    // passphrase or shares by design (rule 1). What CAN be verified here
    // is isRecentAuth() above. OTP-enabled accounts are UNCHANGED — they
    // keep exactly otpSatisfied() as before, still covered by the
    // "hardening" test suite below; OTP-disabled accounts now need
    // isRecentAuth() as their baseline instead of nothing at all.
    function credentialMutationAllowed() {
      return request.auth.token.get('otpEnabled', false) == true
          ? otpSatisfied()
          : isRecentAuth();
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid
                    && isValidUserDoc(request.resource.data);
      // credentialMutationAllowed() here is what closes the OTP-bypass
      // hole: without it a caller holding nothing but a stolen session
      // could overwrite `decryptionMethods.shamir.otpBypassVerifier` with
      // a value whose preimage it chose, then replay that preimage through
      // verifyShamirOtpBypass to mint itself otpVerified claims — reaching
      // every entry's ciphertext without the TOTP device, the passphrase,
      // or a single real Shamir share. The same gate stops that session
      // from destroying the account by overwriting `wrappedSeed` /
      // `publicKeys` (entries are append-only and undeletable, so a seed
      // overwrite is unrecoverable).
      //
      // The Shamir recovery path still works with the OTP device gone:
      // verifyShamirOtpBypass sets otpVerified from real shares FIRST, and
      // only then does the client rewrite wrappedSeed.
      allow update: if request.auth.uid == uid
                    && isKeyRotationRequest()
                    && (isOtpUngatedChange() || credentialMutationAllowed());
      allow delete: if false;
    }

    // Full shape validation for an entry, rather than the previous
    // uid/entrySeq/size spot-checks. Two things it buys beyond bounding
    // storage abuse:
    //
    //  1. Every field the read path feeds into lib/crypto must be present
    //     and a bounded string, so a session-only attacker can't park
    //     half-formed junk documents in a collection that is deliberately
    //     append-only (allow update, delete: if false — junk can never be
    //     removed once written).
    //  2. `aad.uid`/`aad.entrySeq` must agree with the document's own
    //     `uid`/`entrySeq`. Those top-level fields are what listEntries()
    //     queries and orders by, while the `aad` copy is what's actually
    //     bound into the AES-GCM tag (ARCHITECTURE.md §3.4). Letting the
    //     two disagree would mean the ordering the UI displays is not the
    //     ordering the ciphertext authenticates.
    //
    // Sizes are base64 lengths with headroom: ML-KEM-768 ciphertext 1088B
    // -> ~1452 chars; wrapped content key 48B -> 64; X25519 public key and
    // 12-byte IVs well under their caps. 560,000 chars of ciphertext is
    // roughly a 375KB plaintext entry plus §3.15's padding overhead, far
    // past anything a real diary entry needs.
    //
    // What rules deliberately do NOT enforce is global uniqueness of
    // entrySeq — that needs a transactional counter read, which security
    // rules can't express. lib/firebase/entries.ts allocates from
    // users/{uid}.lastEntrySeq (forward-only, above) and
    // app/entries/page.tsx reports duplicates and gaps it sees, so the
    // residue is detectable rather than silent.
    function isValidEntry(data) {
      return data.keys().hasOnly(['uid', 'entrySeq', 'ciphertext', 'iv', 'wrappedContentKey',
                                  'wrappedContentKeyIv', 'kemCiphertext',
                                  'ephemeralX25519PublicKey', 'aad', 'createdAt'])
          && data.uid is string
          && data.entrySeq is int && data.entrySeq > 0 && data.entrySeq <= maxEntrySeq()
          // Ceiling raised from 500,000 with length padding (§3.15): the
          // same entry now stores up to ~12% larger, and an unchanged cap
          // would have started rejecting entries that used to fit.
          && isB64(data.ciphertext, 560000)
          // Floor, not an exact check. A padded record is at least
          // MIN_PADDED_ENTRY_LENGTH (1024) + the 16-byte GCM tag = 1040
          // bytes, which is 1388 base64 chars; anything materially shorter
          // was not padded at all. Rules cannot verify real padding — the
          // bytes are opaque here — but they can refuse the obvious case,
          // so "every stored entry is padded" is structural rather than a
          // promise the client makes to itself.
          && data.ciphertext.size() >= 1380
          && isB64(data.iv, 32)
          && isB64(data.wrappedContentKey, 128)
          && isB64(data.wrappedContentKeyIv, 32)
          && isB64(data.kemCiphertext, 2048)
          && isB64(data.ephemeralX25519PublicKey, 64)
          && data.createdAt is timestamp
          && data.aad.keys().hasOnly(['uid', 'entrySeq', 'createdAt', 'fmt'])
          && data.aad.uid == data.uid
          && data.aad.entrySeq == data.entrySeq
          && data.aad.createdAt is string && data.aad.createdAt.size() <= 40
          // REQUIRED on every new entry (ARCHITECTURE.md §3.15). This is a
          // ratchet: existing unpadded entries keep working (they are only
          // ever read, and `entries` is append-only), but nothing can write
          // an unpadded one again — not a stale client, not a tampered one.
          //
          // DEPLOY ORDER MATTERS because of that: ship the client that
          // writes `fmt` BEFORE deploying these rules, or in-flight clients
          // lose the ability to save. Same constraint in reverse if the
          // client is ever rolled back.
          //
          // The tag is inside the AEAD's AAD as well, which is what makes
          // it meaningful rather than decorative: strip it from the stored
          // document and the entry stops decrypting instead of quietly
          // being read as unpadded.
          && 'fmt' in data.aad && data.aad.fmt == 'padded-v1';
    }

    match /entries/{entryId} {
      allow read: if request.auth.uid == resource.data.uid && otpSatisfied();
      allow create: if request.auth.uid == request.resource.data.uid
                    && isValidEntry(request.resource.data);
      allow update, delete: if false; // append-only: 수정/삭제 자체를 원천 차단
    }
    // The actual TOTP secret. Only functions/src/index.ts (Admin SDK, which
    // bypasses these rules entirely) ever reads or writes this — explicit
    // deny-all here is defense in depth, not the only thing stopping clients.
    match /otpSecrets/{uid} {
      allow read, write: if false;
    }
  }
}
