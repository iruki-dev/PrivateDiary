rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shamir's Secret Sharing: the sole alternative to the passphrase
    // (opt-in) — replaces the removed BIP39 mnemonic and the earlier
    // recovery-key option (see lib/crypto/recovery.ts, ARCHITECTURE.md
    // §3.7). Shares split a random wrap key, not the seed itself, so that
    // key's `wrappedSeed` ciphertext (AES-GCM, same shape as the top-level
    // wrappedSeed) is what's stored here — the shares themselves are never
    // sent to Firestore at all. Reissuing overwrites this ciphertext, which
    // is what actually invalidates any previously-issued shares.
    function isValidDecryptionMethods(methods) {
      return methods.keys().hasOnly(['shamir'])
          && (!('shamir' in methods)
              || (methods.shamir.keys().hasOnly(['n', 'k', 'wrappedSeed'])
                  && methods.shamir.n is int && methods.shamir.k is int
                  && methods.shamir.wrappedSeed.keys().hasOnly(['ciphertext', 'iv'])));
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(['publicKeys', 'signingPublicKey', 'wrappedSeed', 'decryptionMethods', 'createdAt'])
          && data.publicKeys.keys().hasOnly(['x25519', 'mlkem768'])
          && (!('decryptionMethods' in data) || isValidDecryptionMethods(data.decryptionMethods));
    }

    // ARCHITECTURE.md §5 gives `allow update: if ... isKeyRotationRequest()`
    // without defining the function — filled in here. It covers all
    // self-service mutations of the account owner's OWN document:
    //   1. Passphrase change (Phase 4 rewrapSeed): only wrappedSeed changes.
    //   2. Full key reset ("초기화", ARCHITECTURE.md §3.6 rule 5): a brand
    //      new seed, so publicKeys + wrappedSeed (+ decryptionMethods reset
    //      to {}) change together.
    //   3. Enabling/disabling one decryption method: only `decryptionMethods`
    //      (a single sub-field of it, via dotted-path updates) changes.
    // In every case createdAt is immutable and the document shape stays
    // valid. This only ever narrows what an authenticated uid can do to ITS
    // OWN doc — the outer `request.auth.uid == uid` check is what actually
    // prevents cross-user access, not this function.
    function isKeyRotationRequest() {
      return isValidUserDoc(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
    }

    // OTP (TOTP authenticator app) as a server-enforced ACCESS GATE, not a
    // cryptographic factor — see functions/src/index.ts's module doc for
    // why that distinction matters. `otpEnabled` / `otpVerified` /
    // `otpVerifiedAt` are custom claims that only Cloud Functions
    // (functions/src/index.ts, via the Admin SDK) can set — never
    // client-writable, so a client can't forge its way past this by
    // setting its own claims. An account without OTP enabled is
    // unaffected (otpEnabled != true short-circuits to allowed).
    //
    // Only applied to `entries` reads, deliberately NOT to `users/{uid}`:
    // that doc holds `publicKeys` (needed to WRITE — ARCHITECTURE.md §3.2
    // rule 5 says writing must work without any unlock step at all) and
    // `wrappedSeed` (ciphertext that's safe to read without the passphrase
    // per §3.1 step 7). Nothing in `users/{uid}` is plaintext or requires
    // OTP to be harmless; `entries` is where actual diary content lives.
    //
    // Bug fixed here: custom claims live on the Firebase Auth USER record,
    // not on any one browser/device/session — so checking only "was
    // otpVerifiedAt within the last 12h" meant verifying OTP on device A
    // silently satisfied device B's freshly-issued ID token too, for up to
    // 12h, without device B ever entering a code. Firestore rules can't see
    // "which device" made the request, but `auth_time` (a standard claim on
    // every ID token, seconds since epoch, set at sign-in and unchanged by
    // token refreshes) IS per sign-in-session. Requiring
    // otpVerifiedAt to be at/after THIS session's auth_time means a new
    // sign-in on any device — same account or not — always starts back at
    // "not verified" for that session, closing the cross-device gap, while
    // still not re-prompting on every navigation within one already-verified
    // session (auth_time doesn't change just from browsing around).
    function otpSatisfied() {
      // request.auth.token.get(key, default) — a bare `.otpEnabled` throws
      // an evaluation error (not just falsy) for accounts that never set
      // the claim, since Firestore rules maps raise on missing keys.
      return request.auth.token.get('otpEnabled', false) != true
          || (request.auth.token.get('otpVerified', false) == true
              && request.auth.token.get('otpVerifiedAt', 0) >= request.auth.token.get('auth_time', 0) * 1000
              && request.auth.token.get('otpVerifiedAt', 0) > request.time.toMillis() - 43200000); // 12h cap
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid
                    && isValidUserDoc(request.resource.data);
      allow update: if request.auth.uid == uid && isKeyRotationRequest();
      allow delete: if false;
    }
    match /entries/{entryId} {
      allow read: if request.auth.uid == resource.data.uid && otpSatisfied();
      allow create: if request.auth.uid == request.resource.data.uid
                    && request.resource.data.entrySeq is int;
      allow update, delete: if false; // append-only: 수정/삭제 자체를 원천 차단
    }
    // The actual TOTP secret. Only functions/src/index.ts (Admin SDK, which
    // bypasses these rules entirely) ever reads or writes this — explicit
    // deny-all here is defense in depth, not the only thing stopping clients.
    match /otpSecrets/{uid} {
      allow read, write: if false;
    }
  }
}
